NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://dearday:dearday@localhost:5432/dearday
SESSION_SECRET=
KAKAO_REST_API_KEY=
# 새 카카오 앱은 Client Secret이 기본 사용이라 운영에서 필수
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
NEXT_PUBLIC_KAKAO_JS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dearday-media
R2_PUBLIC_BASE_URL=
# 로컬 전용. 1이면 카카오 없이 개발용 로그인 허용. 운영에서는 비워 둘 것
DEV_LOGIN=

# (2차) /admin/stats를 볼 수 있는 카카오 회원번호, 쉼표로 구분
ADMIN_KAKAO_IDS=

# (2차) 새 응답 카톡 알림용 카카오 토큰 암호화 키: hex 64자 (openssl rand -hex 32). 비어 있으면 알림 기능이 꺼진 채 숨겨짐
KAKAO_TOKEN_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://dearday:dearday@localhost:5432/dearday
SESSION_SECRET=
KAKAO_REST_API_KEY=
# 새 카카오 앱은 Client Secret이 기본 사용이라 운영에서 필수
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
NEXT_PUBLIC_KAKAO_JS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dearday-media
R2_PUBLIC_BASE_URL=
# 로컬 전용. 1이면 카카오 없이 개발용 로그인 허용. 운영에서는 비워 둘 것
DEV_LOGIN=

# (2차) /admin/stats를 볼 수 있는 카카오 회원번호, 쉼표로 구분
ADMIN_KAKAO_IDS=

# (2차) 새 응답 카톡 알림용 카카오 토큰 암호화 키: hex 64자 (openssl rand -hex 32). 비어 있으면 알림 기능이 꺼진 채 숨겨짐
KAKAO_TOKEN_KEY=

# (결제) 토스페이먼츠 결제위젯 키. 비어 있으면 결제 버튼이 숨겨지고 모든 기능이 무료. 시크릿 키는 서버에서만 씀
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 결제를 시작하는 시각(ISO 8601, 예 2026-12-01T00:00:00+09:00). 비어 있으면 결제 꺼짐(모든 초대장 무료 · 프리미엄 기능 전부 열림)
PAYMENTS_LIVE=
# 결제 수단: toss(기본, 결제위젯) | groble(그로블 결제 링크 + 웹훅). groble이면 아래 3개가 다 있어야 결제가 열림
PAYMENT_PROVIDER=
# 그로블 결제창 링크 (금액으로 고름: 14,900원 / 3,900원 상품). 결제 시작 때 ?ref=주문번호가 붙음
GROBLE_LINK_14900=
GROBLE_LINK_3900=
# 그로블 웹훅 서명 검증용 시크릿 (서버에서만 씀)
GROBLE_WEBHOOK_SECRET=
# (선택) 그로블 주문조회 주소 — 대시보드 [그로블에서 환불 신청] 링크. 비우면 https://www.groble.im
GROBLE_ORDER_URL=
# e2e 전용: 가짜 토스 서버 주소. 운영에서는 비워 둘 것
TOSS_API_BASE=
